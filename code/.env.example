# ── ai ────────────────────────────────────────────────────────────────
# Anthropic API key — used by claude-agent-sdk.
ANTHROPIC_API_KEY=

# Default model for receipt parsing + assignment AI.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── storage ───────────────────────────────────────────────────────────
# 'local' writes to ./.house/uploads/  |  's3' uploads to AWS_S3_BUCKET.
STORAGE_BACKEND=local

# UPLOAD_DIR=./.house/uploads
# AWS_S3_BUCKET=
# AWS_S3_PREFIX=scans/
# AWS_REGION=eu-central-1

# ── api ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=12
DEV_USER_NAME=mila
# CORS_ORIGINS=["http://localhost:5173"]
