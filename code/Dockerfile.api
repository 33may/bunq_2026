FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps: build tools for any wheels that aren't pure-python (psycopg
# binary wheel ships its own libpq, but pillow needs jpeg/zlib at runtime).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libjpeg62-turbo \
        zlib1g \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY core ./core
COPY pytest.ini ./

# Persistent dirs are mounted as volumes by docker-compose.
RUN mkdir -p /app/.house/uploads /app/.house/profiles /app/.secrets

# Run as non-root. The claude CLI (used by claude-agent-sdk) refuses
# `--dangerously-skip-permissions` under root, killing every AI request.
# Owning /app means uvicorn can write to .house/ at runtime.
RUN groupadd -r app && useradd -r -g app -d /app -s /bin/bash app \
    && chown -R app:app /app
USER app

EXPOSE 8000

# `--proxy-headers` so X-Forwarded-* from nginx reaches Starlette correctly.
CMD ["uvicorn", "core.api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
